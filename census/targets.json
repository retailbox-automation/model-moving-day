  "install": ["pytest<9.0.0,>=8.3.3", "pytest-asyncio>=0.24.0,<2.0.0", "python-dotenv>=1.0.1", "jsonref>=1.1.0,<2.0.0"],
  "pytest_args": ["tests/llm/test_core_providers", "tests/llm/test_openai", "-k", "openai",
